#region Next.js client side variables

NEXT_PUBLIC_STORE_NAME="SP Tech"
NEXT_PUBLIC_ENVIRONMENT=staging

NEXT_PUBLIC_PREVIEW_ENVIRONMENT=true

# PayloadCMS Live Preview Configuration
NEXT_PUBLIC_ENABLE_LIVE_PREVIEW=true
NEXT_PUBLIC_PAYLOAD_SERVER_URL=http://localhost:3100
PAYLOAD_PREVIEW_TOKEN=your-preview-token-here

NEXT_PUBLIC_BASE_URL=https://localhost:3000
NEXT_PUBLIC_BASE_DOMAIN=localhost

NEXT_PUBLIC_BRINK_ENV=XXXXXXX
NEXT_PUBLIC_BRINK_API_URL=https://shopper.eu-west-1.${NEXT_PUBLIC_BRINK_ENV}.brinkcommerce.io/shopper
NEXT_PUBLIC_BRINK_STORE_GROUP_ID=default
NEXT_PUBLIC_BRINK_STORE_GROUP_INVENTORY=XXXXXXX

NEXT_PUBLIC_AUTH_USERNAME=XXXXXXX
NEXT_PUBLIC_AUTH_PASSWORD=XXXXXXX

# Vercel Protection Bypass for API calls when password protection is enabled
# Get this from Vercel Project Settings > General > Protection Bypass for Automation
# Must be NEXT_PUBLIC_ to be available on client-side
NEXT_PUBLIC_VERCEL_AUTOMATION_BYPASS_SECRET=

NEXT_PUBLIC_GOOGLE_MAP_API=XXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

NEXT_PUBLIC_STORYBLOK_TOKEN=XXXXXXX

# Storyblok Webhook Configuration
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORYBLOK_WEBHOOK_SECRET=your_secure_random_string_here
# [OPTIONAL] Skip signature verification for testing (NEVER use in production)
# STORYBLOK_SKIP_SIGNATURE_VERIFICATION=true

NEXT_PUBLIC_SHOW_DEV_DEBUG_INFO=true

# [OPTIONAL] Start level for menu
NEXT_PUBLIC_MENU_START_LEVEL=1

NEXT_PUBLIC_SOCIAL_FACEBOOK='https://#'
NEXT_PUBLIC_SOCIAL_INSTAGRAM='https://#'
NEXT_PUBLIC_SOCIAL_PINTEREST='https://#'
NEXT_PUBLIC_SOCIAL_TIKTOK='https://#'

# [OPTIONAL] List of recommendation ids from https://dashboard.findify.io/solutions/recommendations/widgets
# Format: `market-code:recommendation-drawer-id:recommendation-list-id` separated by semicolon ';'
# `recommendation-drawer-id` or `recommendation-list-id` can be empty. Ex: `se::product-findify-rec-2;`
NEXT_PUBLIC_RECOMMENDATIONS='sv:product-findify-rec-2:product-findify-rec-2;no::;fi::;'

#endregion

# [OPTIONAL] Enable debug mode for services within DI container
DEBUG=false
NEXT_PUBLIC_PRODUCT_TAKE=28
# [OPTIONAL] Secret used for cache invalidation. Min length: 32
CACHE_INVALIDATION_SECRET=

# Single language configuration - English only for all markets
LANGUAGES=en
# Default language (English only)
DEFAULT_LANGUAGE=en

#region Search Engine

SEARCH_ENGINE=TYPESENSE # FINDIFY | ALGOLIA | TYPESENSE
# [SEARCH_FINDIFY_*], [SEARCH_ALGOLIA_*], or [SEARCH_TYPESENSE_*] config is required

# Default selected market if no language is set or found in browser
SEARCH_DEFAULT_MARKET=en

# Required only if SEARCH_ENGINE=TYPESENSE
SEARCH_TYPESENSE_HOST=localhost
SEARCH_TYPESENSE_PORT=8108
SEARCH_TYPESENSE_PROTOCOL=http
SEARCH_TYPESENSE_API_KEY=XXXXXXX
SEARCH_TYPESENSE_COLLECTION=products
SEARCH_TYPESENSE_DEFAULT_LANGUAGE=en

# SEARCH_FINDIFY_[MARKET_CODE] where [MARKET_CODE] is the first part of the URL generation `{*market*}-{language}`
# If the value repeats the market code, instead of `/en-en/` would be just `/en/`
# If set to `en` here, instead of `/se-en/` would be just `/se/`, but for `sv` language (if exist in languages) would be `/se-sv/`
SEARCH_FINDIFY_EN=en
SEARCH_FINDIFY_EN_API_URL=https://api-v3.findify.io/v3
SEARCH_FINDIFY_EN_API_KEY=XXXXXXX

SEARCH_FINDIFY_FI=fi
SEARCH_FINDIFY_FI_API_URL=https://api-v3.findify.io/v3
SEARCH_FINDIFY_FI_API_KEY=XXXXXXX

SEARCH_FINDIFY_NO=no
SEARCH_FINDIFY_NO_API_URL=https://api-v3.findify.io/v3
SEARCH_FINDIFY_NO_API_KEY=XXXXXXX

SEARCH_FINDIFY_SV=sv
SEARCH_FINDIFY_SV_API_URL=https://api-v3.findify.io/v3
SEARCH_FINDIFY_SV_API_KEY=XXXXXXX

# Required only if SEARCH_ENGINE=ALGOLIA
SEARCH_ALGOLIA_EN=en
SEARCH_ALGOLIA_EN_API_URL=https://XXXXXXX
SEARCH_ALGOLIA_EN_API_KEY=XXXXXXX
SEARCH_ALGOLIA_EN_APP_ID=XXXXXXX
SEARCH_ALGOLIA_EN_INDEX_NAME=XXXXXXX

# Required always
SEARCH_ELASTIC_API_URL=https://XXXXXXX
SEARCH_ELASTIC_WAREHOUSE_API_URL=https://XXXXXXX
SEARCH_ELASTIC_API_KEY=XXXXXXX
SEARCH_ELASTIC_DEFAULT_LANGUAGE=en

# [OPTIONAL] Direct Elasticsearch API Configuration
# Set to 'true' to use direct Elasticsearch API instead of Search Application
# This provides better performance through _source filtering and query-level filtering
NEXT_PUBLIC_USE_DIRECT_ELASTIC_API=false
# Rollout percentage for gradual migration (0-100)
NEXT_PUBLIC_ELASTIC_DIRECT_ROLLOUT=0

# [OPTIONAL] Direct Typesense API Configuration
# Set to 'true' to use direct Typesense API for product data
# This provides native Typesense integration for product cards
NEXT_PUBLIC_USE_DIRECT_TYPESENSE_API=false
# Rollout percentage for gradual migration (0-100)
NEXT_PUBLIC_TYPESENSE_DIRECT_ROLLOUT=0

#endregion

#region Reviews (optional)
REVIEWS_PROVIDER=LIPSCORE
REVIEWS_LIPSCORE_API_URL=https://api.lipscore.com
REVIEWS_LIPSCORE_API_KEY=XXXXXXX
REVIEWS_LIPSCORE_SECRET_KEY=XXXXXXX
#endregion

BRINK_SHOPPER_X_API_KEY=XXXXXXX
# Set the Brink StoreGroupId based on the member level (`bonusBasedLevel`) from Voyado
BRINK_STORE_GROUPS="member:MEMBER;gold:GOLD"

RETAIN24_TEMPLATE_ID_FI=XXXXXXX
RETAIN24_TEMPLATE_ID_SE=XXXXXXX 
RETAIN24_REFERENCE_NUMBER=XXXXXXX

SHOPLAB_API_URL=https://XXXXXXX.shoplab.io/api
SHOPLAB_TOKEN=XXXXXXX

VOYADO_ENGAGE_API_URL=https://XXXXXXX.voyado.com/api/v2
VOYADO_ENGAGE_API_KEY=XXXXXXX
VOYADO_ENGAGE_SOFT_KEY=XXXXXXX
#region Auth
AUTH_SECRET=XXXXXXX # Added by `npx auth`. Read more: https://cli.authjs.dev
AUTH_SENDGRID_KEY=XXXXXXX
AUTH_SENDGRID_FROM=XXXXXXX
AUTH_FIREBASE_PROJECT_ID=domain-staging
AUTH_FIREBASE_CLIENT_EMAIL=XXXXXXX
AUTH_FIREBASE_PRIVATE_KEY=XXXXXXX
#endregion

#region Store Management
CMS_API_URL=https://cms.your-domain.com
#endregion
