{
  "buildCommand": "yarn build",
  "framework": "nextjs",
  "functions": {
    "src/app/[locale]/(pages)/products/[...slug]/page.tsx": {
      "maxDuration": 60
    },
    "src/app/api/store-group/route.ts": {
      "maxDuration": 10
    }
  },
  "regions": ["fra1", "arn1"],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/edge/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}