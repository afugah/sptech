    "test:e2e:watch": "jest --config=tests/e2e/jest.config.js --watch",
    "test:e2e:headed": "HEADLESS=false jest --config=tests/e2e/jest.config.js",
    "prepare": "husky",
    "generate-bloom-filter": "ts-node src/redirects/generate-bloom-filters.mjs",
    "performance:baseline": "node scripts/performance-baseline.js",
    "performance:test": "jest --config=tests/performance/jest.config.js",
    "performance:edge": "node scripts/test-edge-performance.js",
    "analyze": "ANALYZE=true yarn build",
    "lighthouse": "npx lighthouse https://localhost:3100 --output json --output-path lighthouse-results.json"
